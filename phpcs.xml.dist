<?xml version="1.0"?>
<ruleset name="atwx/silverstripe-flow">
    <description>Coding standard for atwx/silverstripe-flow.</description>

    <file>src</file>
    <file>tests</file>

    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="PSR12"/>
</ruleset>
