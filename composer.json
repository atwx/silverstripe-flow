{
    "name": "atwx/silverstripe-flow",
    "description": "Domain-neutral case files for Silverstripe: status with history, field permissions per role and status, external edit links, custom fields and a timeline. Built on atwx/silverstripe-frontdesk-kit.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "workflow",
        "case management",
        "frontdesk-kit"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Andy Adiwidjaja",
            "email": "adiwidjaja@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../silverstripe-frontdesk-kit",
            "options": {
                "symlink": true,
                "versions": {
                    "atwx/silverstripe-frontdesk-kit": "dev-main"
                }
            }
        }
    ],
    "require": {
        "php": "^8.4",
        "atwx/silverstripe-frontdesk-kit": "dev-main",
        "silverstripe/admin": "^3",
        "silverstripe/framework": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "cambis/silverstan": "^2",
        "phpstan/extension-installer": "^1.4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Atwx\\Flow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atwx\\Flow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "expose": []
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
